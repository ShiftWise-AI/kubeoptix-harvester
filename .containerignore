# Exclude version control and IDE files
.git/
.vscode/
.idea/

# Exclude Helm charts from the container context when they are not required at runtime
charts/
.helmignore

# Python: ignore local caches and virtual environments
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Exclude heavy documentation and tests that do not run in the container
docs/
tests/
*.md

# Exclude the ignore file itself
.containerignore
.podmanignore
